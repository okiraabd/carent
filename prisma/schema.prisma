// Carent — Action Camera Rental Management System
// Prisma Schema — PostgreSQL (Supabase)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// DOMAIN: USER & AUTH
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

enum Gender {
  MALE
  FEMALE
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile               Profile?
  paymentsVerified      Payment[]           @relation("VerifiedBy")
  identityHoldsReceived IdentityHold[]      @relation("ReceivedBy")
  identityHoldsReturned IdentityHold[]      @relation("ReturnedBy")
  penaltiesCreated      Penalty[]           @relation("PenaltyCreatedBy")
  depositsProcessed     DepositTransaction[] @relation("DepositProcessedBy")
  inspections           InspectionRecord[]  @relation("InspectedBy")
  rulesUpdated          BusinessRule[]      @relation("RuleUpdatedBy")

  @@map("users")
}

model Profile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  fullName       String
  phone          String
  city           String    @default("")
  gender         Gender?
  birthDate      DateTime?
  profession     String?
  referralSource String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics CustomerMetrics?
  bookings Booking[]

  @@map("profiles")
}

model CustomerMetrics {
  id                 String         @id @default(uuid()) @db.Uuid
  profileId          String         @unique @db.Uuid
  totalTransactions  Int            @default(0)
  totalRevenue       Decimal        @default(0) @db.Decimal(12, 2)
  avgRentalDuration  Float          @default(0)
  favoriteCamera     String?
  favoriteActivity   String?
  lastRentalDate     DateTime?
  status             CustomerStatus @default(NEW)
  damageRate         Float          @default(0)
  updatedAt          DateTime       @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("customer_metrics")
}

// ============================================================
// DOMAIN: INVENTORY
// ============================================================

enum CameraStatus {
  AVAILABLE
  BOOKED
  RENTED
  INSPECTION
  MAINTENANCE
  DAMAGED
}

model Camera {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  brand            String
  model            String
  specs            Json?        @default("{}")
  purchaseDate     DateTime?
  purchasePrice    Decimal      @default(0) @db.Decimal(12, 2)
  depreciationValue Decimal     @default(0) @db.Decimal(12, 2)
  dailyRate        Decimal      @db.Decimal(12, 2)
  weekendRate      Decimal?     @db.Decimal(12, 2)
  weeklyRate       Decimal?     @db.Decimal(12, 2)
  storageLocation  String       @default("")
  isHighValue      Boolean      @default(false)
  status           CameraStatus @default(AVAILABLE)
  imageUrls        String[]     @default([])
  totalDaysRented  Int          @default(0)
  totalTimesRented Int          @default(0)
  conditionScore   Int          @default(10)
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accessories       CameraAccessory[]
  bookingItems      BookingItem[]
  maintenanceRecords MaintenanceRecord[]

  @@map("cameras")
}

model Accessory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  type            String
  stock           Int      @default(0)
  dailyRate       Decimal  @default(0) @db.Decimal(12, 2)
  replacementCost Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cameras            CameraAccessory[]
  bookingItemAccessories BookingItemAccessory[]

  @@map("accessories")
}

model CameraAccessory {
  id          String  @id @default(uuid()) @db.Uuid
  cameraId    String  @db.Uuid
  accessoryId String  @db.Uuid
  isIncluded  Boolean @default(true)

  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  accessory Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@unique([cameraId, accessoryId])
  @@map("camera_accessories")
}

// ============================================================
// DOMAIN: TRANSACTION
// ============================================================

enum BookingStatus {
  DRAFT
  AWAITING_PAYMENT
  REJECTED_PAYMENT
  CONFIRMED
  ACTIVE_RENTAL
  DUE_TODAY
  OVERDUE
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentType {
  BOOKING_PAYMENT
  SECURITY_DEPOSIT
  PENALTY
  SETTLEMENT
}

enum PaymentRecordStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityHoldStatus {
  HELD
  RETURNED
}

enum PenaltyType {
  LATE_RETURN
  DAMAGE
  LOST_ACCESSORY
  OTHER
}

enum DepositAction {
  COLLECTED
  DEDUCTED
  REFUNDED_FULL
  REFUNDED_PARTIAL
}

enum InspectionCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  HEAVILY_DAMAGED
}

enum InspectionAction {
  READY
  NEEDS_INSPECTION
  NEEDS_MAINTENANCE
  DECOMMISSION
}

model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingCode           String        @unique
  profileId             String        @db.Uuid
  bookingDate           DateTime      @default(now())
  startDate             DateTime
  endDate               DateTime
  dueTime               DateTime
  duration              Int
  activity              String?
  subtotal              Decimal       @default(0) @db.Decimal(12, 2)
  discount              Decimal       @default(0) @db.Decimal(12, 2)
  bookingPaymentAmount  Decimal       @default(0) @db.Decimal(12, 2)
  securityDepositAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod         String?
  paymentStatus         PaymentStatus @default(UNPAID)
  status                BookingStatus @default(DRAFT)
  checkoutAt            DateTime?
  checkinAt             DateTime?
  isLate                Boolean       @default(false)
  lateMinutes           Int?
  notes                 String?
  expiresAt             DateTime
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  profile       Profile              @relation(fields: [profileId], references: [id])
  items         BookingItem[]
  payments      Payment[]
  identityHold  IdentityHold?
  penalties     Penalty[]
  deposits      DepositTransaction[]
  maintenance   MaintenanceRecord[]

  @@index([profileId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("bookings")
}

model BookingItem {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @db.Uuid
  cameraId        String   @db.Uuid
  dailyRate       Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  conditionBefore String?
  conditionAfter  String?
  photoBeforeUrls String[] @default([])
  photoAfterUrls  String[] @default([])

  booking     Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  camera      Camera                 @relation(fields: [cameraId], references: [id])
  accessories BookingItemAccessory[]
  inspections InspectionRecord[]

  @@index([bookingId])
  @@index([cameraId])
  @@map("booking_items")
}

model BookingItemAccessory {
  id             String  @id @default(uuid()) @db.Uuid
  bookingItemId  String  @db.Uuid
  accessoryId    String  @db.Uuid
  quantity       Int     @default(1)
  isReturned     Boolean @default(false)
  conditionAfter String?

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  accessory   Accessory   @relation(fields: [accessoryId], references: [id])

  @@map("booking_item_accessories")
}

model Payment {
  id              String              @id @default(uuid()) @db.Uuid
  bookingId       String              @db.Uuid
  type            PaymentType
  amount          Decimal             @db.Decimal(12, 2)
  proofUrl        String?
  status          PaymentRecordStatus @default(PENDING)
  verifiedBy      String?             @db.Uuid
  verifiedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime            @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifier User?   @relation("VerifiedBy", fields: [verifiedBy], references: [id])

  @@index([bookingId])
  @@map("payments")
}

model IdentityHold {
  id             String             @id @default(uuid()) @db.Uuid
  bookingId      String             @unique @db.Uuid
  cardType       String
  cardHolderName String
  receivedAt     DateTime           @default(now())
  receivedBy     String             @db.Uuid
  returnedAt     DateTime?
  returnedBy     String?            @db.Uuid
  status         IdentityHoldStatus @default(HELD)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedBy", fields: [receivedBy], references: [id])
  returner User?   @relation("ReturnedBy", fields: [returnedBy], references: [id])

  @@map("identity_holds")
}

model Penalty {
  id               String      @id @default(uuid()) @db.Uuid
  bookingId        String      @db.Uuid
  type             PenaltyType
  description      String
  amount           Decimal     @db.Decimal(12, 2)
  isAutoCalculated Boolean     @default(false)
  createdBy        String      @db.Uuid
  createdAt        DateTime    @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  creator User    @relation("PenaltyCreatedBy", fields: [createdBy], references: [id])

  @@index([bookingId])
  @@map("penalties")
}

model DepositTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @db.Uuid
  action      DepositAction
  amount      Decimal       @db.Decimal(12, 2)
  reason      String?
  processedBy String        @db.Uuid
  processedAt DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  processor User    @relation("DepositProcessedBy", fields: [processedBy], references: [id])

  @@index([bookingId])
  @@map("deposit_transactions")
}

model InspectionRecord {
  id                String              @id @default(uuid()) @db.Uuid
  bookingItemId     String              @db.Uuid
  inspectedBy       String              @db.Uuid
  inspectedAt       DateTime            @default(now())
  overallCondition  InspectionCondition
  notes             String              @default("")
  photoUrls         String[]            @default([])
  recommendedAction InspectionAction

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  inspector   User        @relation("InspectedBy", fields: [inspectedBy], references: [id])

  @@index([bookingItemId])
  @@map("inspection_records")
}

// ============================================================
// DOMAIN: MAINTENANCE
// ============================================================

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  cameraId           String            @db.Uuid
  bookingId          String?           @db.Uuid
  checkDate          DateTime          @default(now())
  type               MaintenanceType
  conditionScore     Int               @default(5)
  description        String
  cause              String?
  repairCost         Decimal           @default(0) @db.Decimal(12, 2)
  technicianName     String?
  downtimeDays       Int               @default(0)
  replacedComponents String?
  replacementCost    Decimal           @default(0) @db.Decimal(12, 2)
  depositClaimed     Decimal           @default(0) @db.Decimal(12, 2)
  photoBefore        String[]          @default([])
  photoAfter         String[]          @default([])
  status             MaintenanceStatus @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  camera  Camera   @relation(fields: [cameraId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([cameraId])
  @@index([bookingId])
  @@map("maintenance_records")
}

// ============================================================
// DOMAIN: BUSINESS RULES
// ============================================================

enum RuleCategory {
  PRICING
  DEPOSIT
  PENALTY
  CANCELLATION
  BOOKING
}

model BusinessRule {
  id          String       @id @default(uuid()) @db.Uuid
  category    RuleCategory
  key         String       @unique
  value       Json
  description String
  isActive    Boolean      @default(true)
  updatedBy   String?      @db.Uuid
  updatedAt   DateTime     @updatedAt

  updater User? @relation("RuleUpdatedBy", fields: [updatedBy], references: [id])

  @@map("business_rules")
}
